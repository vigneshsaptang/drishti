# =============================================================
# SIGINT Platform — Environment Configuration
# Copy to .env and fill in values before deployment
# =============================================================

# --- Domain & TLS ---
# For production: your actual domain (Caddy auto-provisions HTTPS via Let's Encrypt)
# For local dev: localhost
DOMAIN=localhost
ADMIN_EMAIL=admin@yourdomain.com

# --- Authentication ---
# JWT signing secret (generate with: openssl rand -hex 32)
SAPTANG_JWT_SECRET=change-me-to-a-long-random-string

# Platform database name (on the FTI Mongo instance)
MONGO_DB_PLATFORM=auracle_platform

# --- Legacy (auto-migrated on first startup, can remove after) ---
# If set, auto-creates the first admin user from these env vars
# SAPTANG_ADMIN_USER=operator
# SAPTANG_ADMIN_PASSWORD=

# --- MongoDB Connections ---
MONGO_URI_CREDMON=mongodb://user:pass@host:port/?authMechanism=DEFAULT
MONGO_URI_DARKMON=mongodb://user:pass@host:port/?authMechanism=DEFAULT&authSource=admin
MONGO_URI_FTI=mongodb://user:pass@host:port/admin?authSource=admin

# --- Audit Logging ---
# Leave empty to disable audit logging entirely.
# MONGO_URI_AUDIT=mongodb://user:pass@host:port/?authMechanism=DEFAULT
# AUDIT_DB_NAME=auracle_audit
# AUDIT_STORE_PLAINTEXT=false
# AUDIT_HMAC_KEY=generate-a-64-char-hex-string-here
# AUDIT_RETENTION_DAYS=365
# AUDIT_SEARCH_HISTORY_DAYS=90
# AUDIT_BUFFER_SIZE=50
# AUDIT_FLUSH_INTERVAL_S=2.0

# --- Security ---
# IP control (comma-separated CIDR or IPs, leave empty to disable)
# IP_ALLOWLIST=
# IP_BLOCKLIST=

# Brute force IP blocking
# IP_BLOCK_THRESHOLD=50
# IP_BLOCK_DURATION_SECONDS=1800

# Rate limiting (set to false to disable)
# RATE_LIMIT_ENABLED=true

# Credit system (set to false to disable credit checks)
# CREDITS_ENABLED=true

# --- Support & Feedback Email (SMTP) ---
# Leave SMTP_HOST empty to disable email delivery (tickets still stored in MongoDB).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_STARTTLS=true
# SMTP_TIMEOUT_S=30
# SUPPORT_EMAIL_TO=support@saptanglabs.com
# SUPPORT_EMAIL_FROM=auracle@saptanglabs.com
# SUPPORT_EMAIL_FROM_NAME=Auracle Platform
# FEEDBACK_MAX_PER_DAY=10

# --- AI Summary (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Backend ---
BACKEND_PORT=8000
WORKERS=4
LOG_LEVEL=info

# --- Search Defaults ---
MAX_SEARCH_DEPTH=3
MAX_ENTITIES_PER_DEPTH=100
DARKMON_QUERY_TIMEOUT_MS=8000
CREDMON_SOCKET_TIMEOUT_MS=30000
